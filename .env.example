# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Onde encontrar: painel do Supabase > Project Settings > API Keys.
#
# Use somente a Publishable key (sb_publishable_...). Ela pode ir para o navegador
# porque o acesso aos dados é protegido pelas políticas de RLS do banco.
# A Secret key nunca vai em variável NEXT_PUBLIC_ nem com valor neste arquivo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no servidor (sem NEXT_PUBLIC_): nunca chegam ao navegador.
# E-mail(s) da conta ADM, separados por vírgula. Libera o painel /admin.
ADMIN_EMAIL=
# Secret key (sb_secret_...), usada apenas pelo painel /admin para ler as métricas.
# Painel do Supabase > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=
