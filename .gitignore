# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# contexto local do assistente de IA
CLAUDE.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Migrations pessoais (mexem em dados de uma conta específica, como a do autor):
# ficam só na máquina do autor, nunca em commit nem no GitHub. Use _pessoal_ no nome.
supabase/migrations/*_pessoal_*.sql
